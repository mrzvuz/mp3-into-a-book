# Application
APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=500

# PostgreSQL
POSTGRES_DB=mp3book
POSTGRES_USER=your-mac-user
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://your-mac-user@localhost:5432/mp3book

# Transcription
TRANSCRIPTION_PROVIDER=local_whisper
WHISPER_LANGUAGE=uz
WHISPER_MODEL_SIZE=tiny
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Storage
UPLOAD_DIR=/tmp/mp3-book-uploads
